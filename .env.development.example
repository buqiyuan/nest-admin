# logger
LOGGER_LEVEL = debug

# security
# 必填。JWT_SECRET 与 REFRESH_TOKEN_SECRET 必须是各自独立、至少 32 位的随机字符串。
# 生成示例：openssl rand -base64 48
# 缺失、空值、短于 32 位，或仍使用已知占位值时，进程会拒绝启动。
# 复制本文件为 .env.development 后再填写。不要把真实密钥提交到 git。
JWT_SECRET =
JWT_EXPIRE = 86400 # 单位秒
REFRESH_TOKEN_SECRET =
REFRESH_TOKEN_EXPIRE = 2592000

# swagger
SWAGGER_ENABLE = true
SWAGGER_PATH = api-docs
SWAGGER_VERSION = 1.0

# db
# 以下数据库 / Redis 口令只适合本机 Docker。任何共享或生产环境都必须改掉。
DB_HOST = 127.0.0.1
DB_PORT = 13307
DB_DATABASE = nest_admin
DB_USERNAME = root
DB_PASSWORD = root
DB_SYNCHRONIZE = true
DB_LOGGING = ["error"]

# redis
REDIS_PORT = 6379
REDIS_HOST = 127.0.0.1
REDIS_PASSWORD = 123456
REDIS_DB = 0

# smtp
SMTP_HOST =
SMTP_PORT = 465
SMTP_USER =
SMTP_PASS =
