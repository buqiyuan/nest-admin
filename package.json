{
  "name": "nest-admin",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "npm run gen-env-types",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "dev": "npm run start",
    "dev:debug": "npm run start:debug",
    "repl": "npm run start -- --entryFile repl",
    "bundle": "rimraf out && npm run build && ncc build dist/main.js -o out -m -t && chmod +x out/index.js",
    "start": "cross-env NODE_ENV=development nest start -w --path tsconfig.json",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "prod": "cross-env NODE_ENV=production pm2-runtime start ecosystem.config.js",
    "prod:pm2": "cross-env NODE_ENV=production pm2 restart ecosystem.config.js",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:debug": "cross-env NODE_ENV=production nest start --debug --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "doc": "compodoc -p tsconfig.json -s",
    "gen-env-types": "npx tsx scripts/genEnvTypes.ts || true",
    "typeorm": "cross-env NODE_ENV=development typeorm -d ./dist/config/database.config.js",
    "migration:create": "npm run typeorm migration:create ./src/migrations/initData",
    "migration:generate": "npm run typeorm migration:generate ./src/migrations/update-table_$(echo $npm_package_version | sed 's/\\./_/g')",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "cleanlog": "rimraf logs",
    "docker:build:dev": "docker compose --env-file .env --env-file .env.development up --build",
    "docker:build": "docker compose --env-file .env --env-file .env.production up --build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env --env-file .env.production up -d --pull=always",
    "docker:up": "docker compose --env-file .env --env-file .env.production up -d --no-build",
    "docker:down": "docker compose --env-file .env --env-file .env.production down",
    "docker:rmi": "docker compose --env-file .env --env-file .env.production stop nest-admin-server && docker container rm nest-admin-server && docker rmi nest-admin-server",
    "docker:logs": "docker compose --env-file .env --env-file .env.production logs -f"
  },
  "dependencies": {
    "@keyv/redis": "^6.1.0",
    "@nestjs-labs/nestjs-ioredis": "^12.0.0",
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bull": "^12.0.1",
    "@nestjs/cache-manager": "^12.0.4",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/event-emitter": "^12.0.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-node": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "axios": "^1.21.0",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "cron-parser": "^5.10.4",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "keyv": "^6.1.0",
    "lodash": "^4.18.1",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "nestjs-cls": "^7.0.2",
    "nodemailer": "^10.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pluralize": "^8.0.0",
    "qiniu": "^7.15.2",
    "qs": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "stacktrace-js": "^2.0.2",
    "svg-captcha": "^1.4.0",
    "systeminformation": "^5.33.19",
    "ts-node": "^10.9.2",
    "typeorm": "1.1.2",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@compodoc/compodoc": "^2.0.0",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pluralize": "^0.0.33",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "msgpackr": "^1.12.1",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
